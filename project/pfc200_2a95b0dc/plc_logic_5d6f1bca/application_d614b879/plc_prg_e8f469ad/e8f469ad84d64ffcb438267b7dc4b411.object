{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)e8f469ad-84d6-4ffc-b438-267b7dc4b411","ParentGuid":"(Guid)d614b879-ed2d-4375-b77f-8889df14241c","Name":"(string)PLC_PRG","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF GVL_Test.xReset THEN\n    udiCycleCount := 0;\n    uiBlinkCnt    := 0;\n    udiToggles    := 0;\n    iSawtooth     := 0;\n    rPhase        := 0.0;\n    xBlink        := FALSE;\n    GVL_Test.xReset := FALSE;\n    sStatus       := 'Reset done';\nEND_IF\n\n\n// Ny kommentar\nGVL_test.foo := NOT GVL_test.foo;\n\nIF GVL_Test.xEnable THEN\n    udiCycleCount := udiCycleCount + 1;\n\n    // Blinker based on cycle count (no library needed)\n    uiBlinkCnt := uiBlinkCnt + 1;\n    IF uiBlinkCnt >= MAX(GVL_Test.uiBlinkCycles, 1) THEN\n        uiBlinkCnt := 0;\n        xBlink     := NOT xBlink;\n        udiToggles := udiToggles + 1;\n    END_IF\n\n    // Sawtooth 0..1000\n    iSawtooth := iSawtooth + 1;\n    IF iSawtooth > 1000 THEN\n        iSawtooth := 0;\n    END_IF\n\n    // Sine wave test signal\n    rPhase := rPhase + 0.01;\n    IF rPhase > 6.2831853 THEN\n        rPhase := rPhase - 6.2831853;\n    END_IF\n    rSine := 100.0 * SIN(rPhase);\n\n    sStatus := 'Running';\nELSE\n    sStatus := 'Paused';\nEND_IF","LineInfoPersistence":"(string)e8f469ad-84d6-4ffc-b438-267b7dc4b411_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PLC_PRG\nVAR\n    udiCycleCount : UDINT;          // Total PLC cycles since start / reset\n    uiBlinkCnt    : UINT;           // Internal blink counter\n    xBlink        : BOOL;           // Toggles every GVL_Test.uiBlinkCycles cycles\n    udiToggles    : UDINT;          // Number of blink toggles\n    iSawtooth     : INT;            // Ramps 0..1000 then restarts\n    rSine         : REAL;           // Pseudo-analog test signal (-100..100)\n    rPhase        : REAL;\n    sStatus       : STRING(40) := 'Idle';\n\t\n\t\nEND_VAR","LineInfoPersistence":"(string)e8f469ad-84d6-4ffc-b438-267b7dc4b411_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)56","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}